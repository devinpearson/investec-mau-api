{
  "name": "investec-mau-api",
  "version": "0.1.1",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prepublishOnly": "npm run ci",
    "build": "tsup",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "ci": "npm run build && npm run typecheck && npm run lint && npm run check-exports",
    "check-exports": "attw --pack .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "local-release": "changeset version && changeset publish",
    "test:coverage": "vitest run --coverage",
    "example:basic": "tsx examples/basic-usage.ts",
    "example:documents": "tsx examples/documents.ts",
    "example:errors": "tsx examples/error-handling.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "investec",
    "mauritius",
    "mau",
    "api",
    "open banking",
    "banking"
  ],
  "author": "Devin Pearson",
  "license": "MIT",
  "description": "A simple package for interacting with Investec's Mauritius Open Banking API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devinpearson/investec-mau-api.git"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.0",
    "@biomejs/biome": "^2.6.5",
    "@changesets/cli": "^2.27.10",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.5.0",
    "tsx": "^4.23.5",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  }
}
